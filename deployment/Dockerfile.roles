FROM rust@sha256:f1f73538ebe623fd3673a35aff3df358ae1084c64c55646516e5b17b321b6c9b AS builder
WORKDIR /build
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY fixtures ./fixtures
COPY examples ./examples
RUN cargo test --workspace --locked && cargo build --release --workspace --locked
FROM rust@sha256:f1f73538ebe623fd3673a35aff3df358ae1084c64c55646516e5b17b321b6c9b
COPY --from=builder /build/target/release/openproof-witness /usr/local/bin/openproof-witness
RUN mkdir /role && chmod 1777 /role
USER 65532:65532
WORKDIR /role
ENTRYPOINT ["openproof-witness"]
