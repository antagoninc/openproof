# Operator template. Install on each separate role host after provisioning.
# /etc/openproof/role.env is owner-managed, not supplied by an agent/request.
[Unit]
Description=OpenProof experimental authenticated role
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=openproof
Group=openproof
WorkingDirectory=/opt/openproof
EnvironmentFile=/etc/openproof/role.env
ExecStart=/opt/openproof/venv/bin/python /opt/openproof/scripts/role_service.py --role ${ROLE} --state /var/lib/openproof/state --key /etc/openproof/signing.secret --trust /etc/openproof/trust.json --signed-trust /etc/openproof/trust-signed.json --cert /etc/openproof/server.pem --tls-key /etc/openproof/server.key --ca /etc/openproof/client-ca.pem --client-fingerprint ${CLIENT_FINGERPRINT} --bind ${BIND_ADDRESS} --port 8443
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/openproof
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true
LimitNOFILE=256
TasksMax=64
MemoryMax=512M

[Install]
WantedBy=multi-user.target
