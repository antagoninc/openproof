            "old_trust_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "new_trust": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "epoch",
                "expires_at",
                "authority",
                "receiver",
                "witness",
                "previous_authorities",
                "revoked_authorities"
              ],
              "properties": {
                "version": {
                  "const": "openproof-witness/1"
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9223372036854775807
                },
                "expires_at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 18446744073709551615
                },
                "authority": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "receiver": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "witness": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "previous_authorities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "revoked_authorities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "owner_passkey": {
                  "description": "Optional owner passkey (docs/PASSKEY.md). Absent in trusts made before passkey approvals. Once present it must stay identical in later epochs.",
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "public_key",
                    "rp_id",
                    "origin",
                    "from_sequence"
                  ],
                  "properties": {
                    "public_key": {
                      "description": "Lowercase hex SEC1 uncompressed P-256 point (65 bytes)",
                      "type": "string",
                      "pattern": "^04[0-9a-f]{128}$"
                    },
                    "rp_id": {
                      "description": "WebAuthn relying party ID: localhost or a lowercase DNS name",
                      "type": "string",
                      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
                      "maxLength": 253
                    },
                    "origin": {
                      "description": "Exact origin: http://localhost:PORT or https://HOST[:PORT]",
                      "type": "string",
                      "pattern": "^(http://localhost:[1-9][0-9]{0,4}|https://[a-z0-9.-]{1,253}(:[1-9][0-9]{0,4})?)$"
                    },
                    "from_sequence": {
                      "description": "First receipt sequence whose request must carry an owner assertion",
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9223372036854775807
                    }
                  }
                }
              }
            },
            "checkpoint": {
              "type": "object",
              "properties": {
                "payload": {
                  "$ref": "#/$defs/Checkpoint"
                },
                "signature": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{128}$"
                }
              },
              "required": [
                "payload",
                "signature"
              ],
              "additionalProperties": false
            },
            "not_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            },
            "expires_at": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      }
    }
  },
  "$defs": {
    "Approval": {
      "type": "object",
      "properties": {
        "version": {
          "const": "openproof-witness/1"
        },
        "authority": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]{1,80}$"
        },
        "expected_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "receiver": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "version",
        "authority",
        "document",
        "expected_version",
        "content_sha256",
        "nonce",
        "receiver",
        "not_before",
        "expires_at"
      ],
      "additionalProperties": false
    },
    "Receipt": {
      "type": "object",
      "properties": {
        "version": {
          "const": "openproof-witness/1"
        },
        "kind": {
          "enum": [
            "update",
            "gap"
          ]
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "previous": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "approval_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "document": {
          "type": "string",
          "maxLength": 80
        },
        "document_version": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        }
      },
      "required": [
        "version",
        "kind",
        "sequence",
        "previous",
        "approval_sha256",
        "document",
        "document_version",
        "content_sha256",
        "observed_at",
        "reason"
      ],
      "additionalProperties": false
    },
    "Checkpoint": {
      "type": "object",
      "properties": {
        "version": {
          "const": "openproof-witness/1"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "receiver": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "count",
        "head",
        "observed_at",
        "receiver"
      ],
      "additionalProperties": false
    },
    "Request": {
      "type": "object",
      "properties": {
        "approval": {
          "type": "object",
          "properties": {
            "payload": {
              "$ref": "#/$defs/Approval"
            },
            "signature": {
              "type": "string",
              "pattern": "^[0-9a-f]{128}$"
            }
          },
          "required": [
            "payload",
            "signature"
          ],
          "additionalProperties": false
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "owner_assertion": {
          "description": "Optional WebAuthn assertion over the approval digest (docs/PASSKEY.md). Base64url without padding.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authenticator_data",
            "client_data_json",
            "signature"
          ],
          "properties": {
            "authenticator_data": {
              "description": "At most 1024 bytes decoded",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 1366
            },
            "client_data_json": {
              "description": "At most 2048 bytes decoded",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 2731
            },
            "signature": {
              "description": "DER ECDSA P-256 signature, at most 80 bytes decoded",
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]+$",
              "maxLength": 107
            }
          }
        }
      },
      "required": [
        "approval",
        "content"
      ],
      "additionalProperties": false
    },
    "Package": {
      "type": "object",
      "properties": {
        "version": {
          "const": "openproof-witness/1"
        },
        "requests": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/Request"
          }
        },
        "receipts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "payload": {
                "$ref": "#/$defs/Receipt"
              },
              "signature": {
                "type": "string",
                "pattern": "^[0-9a-f]{128}$"
              }
            },
            "required": [
              "payload",
              "signature"
            ],
            "additionalProperties": false
          }
        },
        "checkpoint": {
          "type": "object",
          "properties": {
            "payload": {
              "$ref": "#/$defs/Checkpoint"
            },
            "signature": {
              "type": "string",
              "pattern": "^[0-9a-f]{128}$"
            }
          },
          "required": [
            "payload",
            "signature"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "requests",
        "receipts",
        "checkpoint"
      ],
      "additionalProperties": false
    }
  }
}
