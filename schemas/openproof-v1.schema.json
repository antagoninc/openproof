{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antagon-openproof:schema:1",
  "title": "OpenProof v1 Evidence Bundle",
  "description": "Structural schema. Rust additionally enforces UTF-8 byte limits, source-level numeric forms, key validity, cryptography, and binding invariants.",
  "$ref": "#/$defs/Bundle",
  "$defs": {
    "ActionSpec": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "arguments_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "tool",
        "resource",
        "arguments_sha256"
      ]
    },
    "Authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "openproof/1"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "actor_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "$ref": "#/$defs/ActionSpec"
        },
        "not_before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expires_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "version",
        "run_id",
        "nonce",
        "audience",
        "actor_key",
        "policy_sha256",
        "action",
        "not_before",
        "expires_at"
      ]
    },
    "Action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "openproof/1"
        },
        "authorization_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "action": {
          "$ref": "#/$defs/ActionSpec"
        },
        "claimed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "version",
        "authorization_sha256",
        "action",
        "claimed_at"
      ]
    },
    "Receipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": "openproof/1"
        },
        "action_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "observed_at": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "output_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "version",
        "action_sha256",
        "observed_at",
        "outcome",
        "output_sha256"
      ]
    },
    "SignedAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/Authorization"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "payload",
        "signature"
      ]
    },
    "SignedAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/Action"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "payload",
        "signature"
      ]
    },
    "SignedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/Receipt"
        },
        "signature": {
          "type": "string",
          "pattern": "^[0-9a-f]{128}$"
        }
      },
      "required": [
        "payload",
        "signature"
      ]
    },
    "Bundle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authorization": {
          "$ref": "#/$defs/SignedAuthorization"
        },
        "action": {
          "$ref": "#/$defs/SignedAction"
        },
        "receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/SignedReceipt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "authorization",
        "action"
      ]
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "actor_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "executor_key": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "nonce": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expected_action": {
          "$ref": "#/$defs/ActionSpec"
        },
        "now": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "authority_key",
        "actor_key",
        "executor_key",
        "run_id",
        "nonce",
        "audience",
        "policy_sha256",
        "expected_action",
        "now"
      ]
    }
  }
}
